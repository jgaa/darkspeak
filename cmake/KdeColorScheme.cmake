# Native KDE integration is optional and supported only on Linux.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    if(NOT DEFINED DARKSPEAK_KDE_COLOR_SCHEME)
        find_package(KF6ColorScheme 6.6 QUIET)
        option(DARKSPEAK_KDE_COLOR_SCHEME "Use KDE Native color schemes" ${KF6ColorScheme_FOUND})
    endif()
    if(DARKSPEAK_KDE_COLOR_SCHEME)
        find_package(KF6ColorScheme 6.6 REQUIRED)
        message(STATUS "DarkSpeak Native colors: KDE ColorScheme")
    else()
        message(STATUS "DarkSpeak Native colors: Qt fallback (KDE ColorScheme disabled or unavailable)")
    endif()
endif()

function(darkspeak_link_color_scheme target)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND DARKSPEAK_KDE_COLOR_SCHEME)
        target_link_libraries(${target} PRIVATE KF6::ColorScheme)
        target_compile_definitions(${target} PRIVATE DARKSPEAK_KDE_COLOR_SCHEME=1)
    endif()
endfunction()
